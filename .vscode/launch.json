{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flash and Debug FRDM-MCXN236",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/output/mcxn236_image_processing.elf",

            "servertype": "pyocd",
            "serverpath": "${workspaceFolder}/python_env/Scripts/pyocd.exe",
            "targetId": "mcxn236vdf",
            "interface": "swd",

            "armToolchainPath": "${workspaceFolder}/toolchain/bin",

            "gdbServerTimeout": 60000,
            "runToEntryPoint": "main",
            "breakAfterReset": true,

            "showDevDebugOutput": "raw"
        }
    ]
}